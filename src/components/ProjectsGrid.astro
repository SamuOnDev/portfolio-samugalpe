---
import { projects } from '../data/projects';
import { t, type ActiveLang } from '../i18n';

interface Props {
    lang: ActiveLang;
}

const { lang } = Astro.props as Props;
---

<section id="projects" class="bg-[#070d13] py-24">
    <div class="mx-auto max-w-content px-4">
        <div class="mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div class="space-y-2">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">{t(lang, 'section_projects_eyebrow')}</p>
                <h2 class="text-3xl font-semibold tracking-tight text-slate-100">{t(lang, 'section_projects_title')}</h2>
                <p class="max-w-2xl text-sm text-slate-400">{t(lang, 'section_projects_subtitle')}</p>
            </div>
            <div class="text-xs text-slate-500">{t(lang, 'section_projects_meta').replace('{count}', projects.length.toString())}</div>
        </div>

        <div class="grid gap-6 lg:grid-cols-2">
            {projects.map((p) => (
                <article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#0b1218] transition hover:-translate-y-1 hover:border-brand-gold/50">
                    <div class="relative h-52 overflow-hidden border-b border-white/10">
                        <img src={p.screenshot} alt={p.name} class="h-full w-full object-cover object-top opacity-75 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-90" loading="lazy" />
                        <div class="absolute inset-0 bg-gradient-to-t from-[#0b1218] via-transparent to-transparent" />
                        <div class="absolute left-4 top-4 inline-flex rounded-full border border-white/20 bg-[#081018]/90 px-2 py-1 text-[0.68rem] uppercase tracking-[0.14em] text-slate-200">{p.type}</div>
                    </div>

                    <div class="flex flex-1 flex-col gap-4 p-5">
                        <div>
                            <h3 class="text-xl font-semibold text-slate-100">{p.name}</h3>
                            <p class="mt-2 text-sm leading-relaxed text-slate-300">{p.description[lang]}</p>
                        </div>

                        <div class="grid grid-cols-2 gap-2 text-xs text-slate-400">
                            <div class="rounded-lg border border-white/10 bg-[#0f1820] px-3 py-2">
                                <p class="text-[0.65rem] uppercase tracking-[0.14em] text-slate-500">{t(lang, 'project_meta_stack')}</p>
                                <p class="mt-1 text-slate-200">{p.tech.slice(0, 3).join(' · ')}</p>
                            </div>
                            <div class="rounded-lg border border-white/10 bg-[#0f1820] px-3 py-2">
                                <p class="text-[0.65rem] uppercase tracking-[0.14em] text-slate-500">{t(lang, 'project_meta_year')}</p>
                                <p class="mt-1 text-slate-200">{p.year}</p>
                            </div>
                        </div>

                        <div class="mt-auto flex items-center gap-3 pt-1 text-sm">
                            {p.liveUrl && <a href={p.liveUrl} target="_blank" rel="noreferrer" class="rounded-md border border-brand-gold/60 px-3 py-1.5 font-medium text-brand-cream transition hover:bg-brand-gold/15">{t(lang, 'project_cta_live')}</a>}
                            {p.codeUrl && <a href={p.codeUrl} target="_blank" rel="noreferrer" class="text-slate-300 transition hover:text-slate-100">{t(lang, 'project_cta_code')}</a>}
                        </div>
                    </div>
                </article>
            ))}

            <article class="flex h-full flex-col justify-between rounded-2xl border border-dashed border-white/15 bg-[#0a1117] p-6">
                <div>
                    <p class="text-xs uppercase tracking-[0.2em] text-slate-500">{t(lang, 'project_next_eyebrow')}</p>
                    <h3 class="mt-3 text-xl font-semibold text-slate-100">{t(lang, 'project_next_title')}</h3>
                    <p class="mt-2 text-sm text-slate-400">{t(lang, 'project_next_text')}</p>
                </div>
                <a href="#contact" class="mt-6 inline-flex w-fit rounded-md border border-white/20 px-3 py-1.5 text-sm text-slate-200 transition hover:border-brand-gold/50 hover:text-slate-100">{t(lang, 'project_next_cta')}</a>
            </article>
        </div>
    </div>
</section>
