---
import Nav from '../../components/Nav.astro';
import SEO from '../../components/SEO.astro';
import CookieBanner from '../../components/CookieBanner.astro';
import Footer from '../../components/Footer.astro';
import ProjectsGrid from '../../components/ProjectsGrid.astro';
import { t, LANGS, type ActiveLang, getAlternateLinks } from '../../i18n';

export function getStaticPaths() {
    return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as ActiveLang;
const pagePath = '/';
const alternates = getAlternateLinks(lang, pagePath);

const heroChips = t(lang, 'hero_value_chips').split(';');
const capabilities = [
    {
        title: t(lang, 'stack_frontend_title'),
        items: t(lang, 'stack_frontend_items').split(';')
    },
    {
        title: t(lang, 'stack_backend_title'),
        items: t(lang, 'stack_backend_items').split(';')
    },
    {
        title: t(lang, 'stack_infra_title'),
        items: t(lang, 'stack_infra_items').split(';')
    }
];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <SEO lang={lang} titleKey="seo_home_title" descriptionKey="seo_home_description" path={`/${lang}/`} alternates={alternates} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>
    <body class="bg-[#050a10] text-slate-100">
        <CookieBanner lang={lang} />
        <Nav lang={lang} path={pagePath} />

        <main>
            <section id="top" class="bg-[radial-gradient(circle_at_20%_10%,rgba(47,183,161,0.12),transparent_45%)] py-14 md:py-20">
                <div class="mx-auto grid max-w-content gap-10 px-4 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
                    <div>
                        <p class="inline-flex rounded-full border border-brand-gold/40 bg-brand-gold/10 px-3 py-1 text-xs font-medium uppercase tracking-[0.14em] text-brand-cream">{t(lang, 'hero_availability')}</p>
                        <h1 class="mt-5 max-w-2xl text-4xl font-semibold leading-tight tracking-tight text-slate-100 md:text-6xl">{t(lang, 'hero_title')}</h1>
                        <p class="mt-5 max-w-xl text-base leading-relaxed text-slate-300">{t(lang, 'hero_subtitle')}</p>

                        <div class="mt-7 flex flex-wrap gap-3">
                            <a href="#contact" class="rounded-md border border-brand-gold/70 bg-brand-gold/20 px-5 py-2.5 text-sm font-semibold text-brand-cream transition hover:bg-brand-gold/30">{t(lang, 'hero_primary')}</a>
                            <a href="#projects" class="rounded-md border border-white/15 px-5 py-2.5 text-sm text-slate-200 transition hover:border-white/35 hover:text-slate-50">{t(lang, 'hero_secondary')}</a>
                        </div>

                        <div class="mt-7 flex flex-wrap gap-2.5">
                            {heroChips.map((chip) => (
                                <span class="rounded-full border border-white/15 bg-[#0a1118] px-3 py-1 text-xs text-slate-300">{chip}</span>
                            ))}
                        </div>
                    </div>

                    <div class="space-y-3">
                        <aside class="overflow-hidden rounded-2xl border border-white/10 bg-[#0a1118]">
                            <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
                                <span class="h-2.5 w-2.5 rounded-full bg-[#fb5f57]" />
                                <span class="h-2.5 w-2.5 rounded-full bg-[#fdbc2e]" />
                                <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]" />
                                <span class="ml-2 text-xs text-slate-500">portfolio.config.ts</span>
                            </div>
                            <pre class="overflow-x-auto px-4 py-5 text-sm leading-7 text-slate-300"><code><span class="text-slate-500">export const</span> projectSetup = &#123;
  <span class="text-brand-cream">architecture</span>: <span class="text-emerald-300">'modular'</span>,
  <span class="text-brand-cream">performance</span>: <span class="text-emerald-300">'95+ lighthouse'</span>,
  <span class="text-brand-cream">delivery</span>: <span class="text-emerald-300">'clear scope + weekly updates'</span>,
  <span class="text-brand-cream">maintenance</span>: <span class="text-emerald-300">'simple handoff'</span>
&#125;;</code></pre>
                        </aside>

                        <div class="grid gap-3 sm:grid-cols-2">
                            <div class="rounded-xl border border-white/10 bg-[#0b1219] px-4 py-3">
                                <p class="text-[0.68rem] uppercase tracking-[0.14em] text-slate-500">{t(lang, 'hero_metric_one_label')}</p>
                                <p class="mt-1 text-lg font-semibold text-slate-100">{t(lang, 'hero_metric_one_value')}</p>
                            </div>
                            <div class="rounded-xl border border-white/10 bg-[#0b1219] px-4 py-3">
                                <p class="text-[0.68rem] uppercase tracking-[0.14em] text-slate-500">{t(lang, 'hero_metric_two_label')}</p>
                                <p class="mt-1 text-lg font-semibold text-slate-100">{t(lang, 'hero_metric_two_value')}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <ProjectsGrid lang={lang} />

            <section id="about" class="border-y border-white/8 bg-[#060c12] py-24">
                <div class="mx-auto max-w-content px-4">
                    <div class="max-w-3xl space-y-4">
                        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">{t(lang, 'section_about_eyebrow')}</p>
                        <h2 class="text-3xl font-semibold tracking-tight text-slate-100">{t(lang, 'section_about_title')}</h2>
                        <p class="text-base leading-relaxed text-slate-300">{t(lang, 'section_about_p1')}</p>
                        <p class="text-base leading-relaxed text-slate-400">{t(lang, 'section_about_p2')}</p>
                    </div>
                </div>
            </section>

            <section id="stack" class="bg-[#070d13] py-24">
                <div class="mx-auto max-w-content px-4">
                    <div class="mb-10 space-y-3">
                        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">{t(lang, 'section_stack_eyebrow')}</p>
                        <h2 class="text-3xl font-semibold tracking-tight text-slate-100">{t(lang, 'section_stack_title')}</h2>
                        <p class="text-sm text-slate-400">{t(lang, 'section_stack_subtitle')}</p>
                    </div>

                    <div class="grid gap-4 md:grid-cols-3">
                        {capabilities.map((group) => (
                            <article class="rounded-2xl border border-white/10 bg-[#0b1218] p-5">
                                <h3 class="text-lg font-semibold text-slate-100">{group.title}</h3>
                                <ul class="mt-4 space-y-2 text-sm text-slate-300">
                                    {group.items.map((item) => (
                                        <li class="flex items-start gap-2"><span class="mt-[0.42rem] h-1.5 w-1.5 rounded-full bg-brand-gold" />{item}</li>
                                    ))}
                                </ul>
                            </article>
                        ))}
                    </div>
                </div>
            </section>

            <section id="contact" class="bg-[#060b10] py-24">
                <div class="mx-auto grid max-w-content gap-8 px-4 lg:grid-cols-[1fr_1.1fr]">
                    <div class="space-y-5">
                        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">{t(lang, 'section_contact_eyebrow')}</p>
                        <h2 class="text-3xl font-semibold tracking-tight text-slate-100">{t(lang, 'section_contact_title')}</h2>
                        <p class="text-base text-slate-300">{t(lang, 'section_contact_subtitle')}</p>
                        <ul class="space-y-2 text-sm text-slate-400">
                            <li>{t(lang, 'section_contact_item1')}</li>
                            <li>{t(lang, 'section_contact_item2')}</li>
                            <li>{t(lang, 'section_contact_item3')}</li>
                        </ul>
                        <div class="grid gap-2 text-sm text-slate-300 sm:grid-cols-2">
                            <p class="rounded-lg border border-white/10 bg-[#0b1118] px-3 py-2">{t(lang, 'contact_signal_1')}</p>
                            <p class="rounded-lg border border-white/10 bg-[#0b1118] px-3 py-2">{t(lang, 'contact_signal_2')}</p>
                            <p class="rounded-lg border border-white/10 bg-[#0b1118] px-3 py-2 sm:col-span-2">{t(lang, 'contact_signal_3')}</p>
                        </div>
                    </div>

                    <form class="space-y-4 rounded-2xl border border-white/10 bg-[#0b1218] p-6" action="mailto:TU_EMAIL_AQUI" method="post" enctype="text/plain">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-sm text-slate-300" for="name">{t(lang, 'contact_name_label')}</label>
                            <input id="name" name="name" type="text" required class="rounded-md border border-white/15 bg-[#070d13] px-3 py-2.5 text-sm text-slate-100 outline-none transition focus:border-brand-gold/70" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-sm text-slate-300" for="email">{t(lang, 'contact_email_label')}</label>
                            <input id="email" name="email" type="email" required class="rounded-md border border-white/15 bg-[#070d13] px-3 py-2.5 text-sm text-slate-100 outline-none transition focus:border-brand-gold/70" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-sm text-slate-300" for="message">{t(lang, 'contact_message_label')}</label>
                            <textarea id="message" name="message" rows="5" required class="resize-none rounded-md border border-white/15 bg-[#070d13] px-3 py-2.5 text-sm text-slate-100 outline-none transition focus:border-brand-gold/70" />
                        </div>
                        <button type="submit" class="inline-flex w-full items-center justify-center rounded-md border border-brand-gold/70 bg-brand-gold/20 px-5 py-2.5 text-sm font-semibold text-brand-cream transition hover:bg-brand-gold/30">{t(lang, 'contact_submit')}</button>
                    </form>
                </div>
            </section>
        </main>

        <Footer lang={lang} />
    </body>
</html>
